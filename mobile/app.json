{
  "expo": {
    "name": "SkillBite",
    "slug": "skillbite",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "platforms": [
      "ios",
      "android",
      "web"
    ],
    "icon": "./assets/App_Logo.png",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.skillbite.app"
    },
    "android": {
      "package": "com.skillbite.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/App_Logo.png",
        "backgroundColor": "#FBF4EB"
      }
    },
    "scheme": "skillbite",
    "plugins": [
      "expo-asset",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FBF4EB",
          "image": "./assets/App_Logo.png",
          "imageWidth": 200,
          "resizeMode": "contain"
        }
      ],
      "expo-video"
    ]
  }
}
